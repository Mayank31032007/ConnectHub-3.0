PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Production: set this to the persistent disk mount path configured by your host.
DATA_DIR=./data
# Local dev origin; production can use your public site URL.
CLIENT_URL=http://localhost:5173

# Optional overrides when using a custom public domain.
# CLIENT_URL=https://chat.example.com
# PUBLIC_APP_URL=https://chat.example.com
# Optional TURN server for calls across restrictive NATs (use time-limited credentials in production).
TURN_URL=

TURN_SHARED_SECRET=
# Optional Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
